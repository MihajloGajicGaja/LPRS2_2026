|||                          Beta compiler                           |||
||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||||

.include /usr/local/share/beta/beta.uasm
BR(start)
x: LONG(0)
y: LONG(0)
i: LONG(0)
suma: LONG(0)

start:
ADDC(r31, 5, r1)
ST(r1, x, r31)
ADDC(r31, 10, r1)
ST(r1, y, r31)
ADDC(r31, 0, r1)
ST(r1, suma, r31)
LD(r31, x, r1)
CMPLTC(r1, 8, r1)
BEQ(r1, L0, r31)
LD(r31, y, r1)
ADDC(r1, 1, r1)
ST(r1, y, r31)
BR(L1)

L0:
ADDC(r31, 0, r1)
ST(r1, y, r31)

L1:

L2:
LD(r31, y, r1)
ADDC(r31, 0, r2)
CMPLT(r2, r1, r1)
BEQ(r1, L3, r31)
LD(r31, suma, r1)
LD(r31, y, r2)
ADD(r1, r2, r1)
ST(r1, suma, r31)
LD(r31, y, r1)
SUBC(r1, 1, r1)
ST(r1, y, r31)
BR(L2)

L3:
ADDC(r31, 1, r1)
ST(r1, i, r31)

L4:
LD(r31, i, r1)
CMPLEC(r1, 5, r1)
BEQ(r1, L5, r31)
LD(r31, suma, r1)
LD(r31, i, r2)
ADD(r1, r2, r1)
ST(r1, suma, r31)
LD(r31, i, r1)
ADDC(r1, 1, r1)
ST(r1, i, r31)
BR(L4)

L5:
LD(r31, suma, r1)
ADD(r1, r31, r0)
HALT()
